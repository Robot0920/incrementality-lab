{
  "name": "incrementality-lab",

  // Python 3.12 is pinned deliberately. As of 2026-09, causalml requires >=3.11 and ships
  // wheels only for cp311/cp312; econml ships cp310-cp313; dowhy is pure Python. 3.12 is
  // the only version where every dependency installs from a wheel. Moving to 3.13 would
  // force causalml to build from source on a 2-core machine.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // uv resolves and installs an order of magnitude faster than pip, which is the
  // difference between a 3-minute and a 30-second cold start.
  "postCreateCommand": "pip install --quiet uv && uv pip install --system -r requirements.txt",
  "postAttachCommand": "make help",

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "files.trimTrailingWhitespace": true
      }
    }
  },

  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}"
  }
}
